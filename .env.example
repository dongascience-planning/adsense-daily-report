# 이 파일을 .env 로 복사한 뒤 값을 채우세요 (cp .env.example .env)
# .env 는 절대 커밋 금지

# --- AdSense OAuth (데스크톱 앱 클라이언트) ---
ADSENSE_CLIENT_ID=
ADSENSE_CLIENT_SECRET=
ADSENSE_ACCOUNT=pub-8747961643354099

# --- GA4 ---
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=./ga4-key.json

# --- 목표 ---
# 이번 달 AdSense 수익 목표 (USD). 비우면 목표 라인 생략.
MONTHLY_REVENUE_GOAL=

# --- 인사이트 생성 ---
# 로컬은 claude CLI 사용. 클라우드(GitHub Actions)는 claude CLI 가 없으므로
# 아래 API 키가 있어야 고품질 인사이트가 생성됨(없으면 규칙기반 요약으로 대체).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Jandi ---
JANDI_WEBHOOK_URL=
